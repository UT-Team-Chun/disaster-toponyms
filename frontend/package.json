{
  "name": "frontend",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "yarn typecheck && eslint . --ext .ts,.tsx",
    "fmt": "prettier --write .",
    "gen": "yarn run orval",
    "test": "vitest",
    "ci:test": "vitest run",
    "build:pages": "VITE_BASE_PATH=/disaster-toponyms/ react-router build && cp build/client/index.html build/client/404.html && touch build/client/.nojekyll",
    "preview:pages": "npx --yes serve -s build/client -l 4173"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@react-router/fs-routes": "^7.9.5",
    "@react-router/node": "^7.9.2",
    "@react-router/serve": "^7.9.2",
    "@t3-oss/env-core": "^0.13.8",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.31",
    "lucide-react": "^0.553.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@react-router/dev": "^7.9.2",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/w3c-image-capture": "^1.0.11",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "orval": "^7.17.0",
    "prettier": "^3.7.4",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.7",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.5"
  }
