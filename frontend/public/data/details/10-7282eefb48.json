{"id":"10-7282eefb48","name":"柿木谷戸","reading":"カキノキガイト","reading_estimated":false,"variants":[],"status":"historical","renamed_to":null,"admin":{"pref_code":"10","pref":"群馬県","municipality_code":null,"municipality":"桐生市","oaza":"堤町","koaza":"柿木谷戸","historical_village":"堤村"},"location":{"lat":36.42040476724137,"lon":139.3262143189655,"precision":"municipality","geocode_source":"geolonia"},"hazard_types":["flood"],"elements":[{"element_id":"kake","surface":"柿","reading":"カケ","meaning":"斜面・崖。豊川市では欠下、岸下などの小字名が土砂災害危険箇所と重なる。"},{"element_id":"yato","surface":"谷戸","reading":"ヤト","meaning":"谷口・低湿地。桐生市域では谷口の地名が集落名に転じた例が多い。豊川市の貝津（カイツ）は垣内由来とされるが小河川沿いに分布する傾向がある。"}],"etymology_summary":"谷戸は谷口をいう地名であったが、地形上人が住み良い所なので、最初に集落が出来た為集落名に変化した。後世は更に拡大して平地の集落地にもなった。ヶ谷戸が本字。ガヤトがガイトに変化した。浄運寺所有地６丁目３９１～３９７はもとは柿ノ木。柿はカケ（欠）の換字で崖の意。キ（木）はキハ（際）の","evidence":[{"kind":"local_history","stance":"supports","source_id":"kiryu_timeikou_2000","locator":null,"quote":"台地の端が新川の洪水の時に崩されて崖になっている所にある集落。","claim":"『桐生市地名考』が柿木谷戸を災害由来の地名と明記する（洪水）","level":2,"extracted_by":"human","quote_verified":true}],"evidence_level":2,"disputed":false,"dispute_note":null,"hazard_corroboration":{"debris_flow_zone":false,"steep_slope_zone":false,"landslide_zone":false,"flood_zone":false,"tsunami_zone":false,"storm_surge_zone":false,"avalanche_risk":false,"nearest_monument_ids":["10203-003"],"related_disasters":[],"sampled_at":"2026-09-10T17:34:33+00:00"},"review":{"status":"auto","reviewer":null,"note":null},"dataset":"kiryu_timeikou","evidenceLevelLabel":"災害由来・替字の明記","hazardLabels":["洪水・河川氾濫"]}
