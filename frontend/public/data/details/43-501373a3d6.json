{"id":"43-501373a3d6","name":"水島","reading":"ミズ","reading_estimated":false,"variants":[],"status":"historical","renamed_to":null,"admin":{"pref_code":"43","pref":"熊本県","municipality_code":"43202","municipality":"八代市","oaza":"水島町","koaza":null,"province":"肥後","district":"八代郡","historical_village":null},"location":{"lat":32.470277,"lon":130.573611,"precision":"koaza","geocode_source":"nihu:歴史地名データ"},"area_key":"432020900","hazard_types":[],"elements":[],"etymology_summary":"島中に水がなかった際、崖から寒泉が湧き出たため、水島と名づけたとされる。","evidence":[{"kind":"gazetteer","stance":"supports","source_id":"yoshida_dainihon_chimei_1907","locator":"https://dl.ndl.go.jp/pid/2937057/1/871","quote":"景行紀曰「天皇自海路泊葦北小島、而進食(吳竹集曰、國王に水島よりおみたしを献る、景行の御時也)時、召山部阿弭古之祖小左、令進冷水、適是時島中無水、不知所爲、小左仰而祈天神地祇、忽寒泉從崖滿傍出、乃酌以獻焉、故名其島曰水島、其泉今在水島崖」","claim":"崖から湧いた寒泉を献じたことにより、その島を水島と名づけたとする記述を裏づける。","level":1,"extracted_by":"llm:gpt-5.6-terra","quote_verified":true,"quote_medium":"ocr"}],"disaster_records":[],"origin_level":1,"evidence_level":1,"disputed":false,"dispute_note":null,"hazard_corroboration":{"debris_flow_zone":false,"steep_slope_zone":false,"landslide_zone":false,"flood_zone":true,"tsunami_zone":true,"storm_surge_zone":true,"avalanche_risk":false,"nearest_monument_ids":[],"sampled_at":"2026-09-11T05:00:26+00:00"},"review":{"status":"auto","reviewer":null,"note":null},"dataset":"dainihon_chimei","evidenceLevelLabel":"地形由来の記載あり","hazardLabels":[]}
